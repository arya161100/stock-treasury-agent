# Copy to .env (which is gitignored). Never commit a real key.
# For Base Sepolia deploys and official-bridge funding ONLY.
# The wallet must be 0xA514D7E29abaEb5a4bc4932B0F488A4c20f69D22.
# QDAY_PRIVATE_KEY=0x...

# Optional RPC overrides
# BASE_SEPOLIA_RPC=https://sepolia.base.org
# ETH_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Local demo (Anvil's well-known account #0 is the default; this is a public test key)
# LOCAL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# NETWORK=anvil
# RPC_URL=http://127.0.0.1:8545
# SERVICE_URL=http://127.0.0.1:4021
# RESEARCH_PRICE_USDC=150000000
# BRIDGE_ETH_AMOUNT=0.2

# If you already hold official Circle USDC on Base Sepolia, set this for DeploySepolia:
# USE_CIRCLE_USDC=true
